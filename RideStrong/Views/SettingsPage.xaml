<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RideStrong.Views.SettingsPage"
             xmlns:viewmodels="clr-namespace:RideStrong.ViewModels"
             x:DataType="viewmodels:SettingsViewModel"
             Style="{StaticResource PageBackgroundStyle}"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="0">

            <!-- Header -->
            <HorizontalStackLayout Spacing="12" Margin="0,0,0,8">
                <Image Source="settings.svg"
                       WidthRequest="32"
                       HeightRequest="32">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource FitnessOrange}" />
                    </Image.Behaviors>
                </Image>
                <Label Text="Settings"
                       Style="{StaticResource TitleTextStyle}"/>
            </HorizontalStackLayout>

            <Label Text="Manage your preferences and data"
                   Style="{StaticResource SubtitleTextStyle}"
                   Margin="0,0,0,32"/>

            <!-- Bike Configuration Section -->
            <Label Text="Bike Configuration"
                   Style="{StaticResource SectionHeaderStyle}"/>

            <Border Style="{StaticResource FeatureCardStyle}">
                <VerticalStackLayout Spacing="24">
                    <!-- Your Weight -->
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Your Weight (kg):"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding UserWeight, StringFormat='{0:F0}'}"
                                   Style="{StaticResource CardTitleStyle}"
                                   TextColor="{StaticResource FitnessOrange}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Slider Minimum="40"
                                Maximum="150"
                                Value="{Binding UserWeight}"
                                MinimumTrackColor="{StaticResource FitnessOrange}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                ThumbColor="{StaticResource FitnessOrange}"/>

                        <Label Text="Used for personalized calorie calculations"
                               Style="{StaticResource CardDescriptionStyle}"/>
                    </VerticalStackLayout>

                    <!-- Save Settings Button -->
                    <Button Text="Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            BackgroundColor="{StaticResource FitnessOrange}"
                            TextColor="{StaticResource White}"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            CornerRadius="12"/>
                </VerticalStackLayout>
            </Border>

            <!-- Data Management Section -->
            <Label Text="Data Management"
                   Style="{StaticResource SectionHeaderStyle}"/>

            <Border Style="{StaticResource FeatureCardStyle}">
                <VerticalStackLayout Spacing="16">

                    <!-- Total Workouts Display -->
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Background="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}"
                            Padding="16">
                        <HorizontalStackLayout Spacing="12">
                            <VerticalStackLayout HorizontalOptions="FillAndExpand">
                                <Label Text="Total Workouts"
                                       Style="{StaticResource CardTitleStyle}"/>
                                <Label Text="Saved locally on your device"
                                       Style="{StaticResource CardDescriptionStyle}"/>
                            </VerticalStackLayout>
                            <Label Text="{Binding TotalWorkouts}"
                                   FontSize="40"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource FitnessOrange}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Export Button -->
                    <Button Text="⬇ Export All Workouts (JSON)"
                            Command="{Binding ExportWorkoutsCommand}"
                            BackgroundColor="#3B82F6"
                            TextColor="{StaticResource White}"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            CornerRadius="12"/>

                    <!-- Delete Button -->
                    <Button Text="🗑 Delete All Workouts"
                            Command="{Binding DeleteAllWorkoutsCommand}"
                            BackgroundColor="#EF4444"
                            TextColor="{StaticResource White}"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            CornerRadius="12"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
